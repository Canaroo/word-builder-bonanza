# Leaderboard
# -----------
# "online" (default) uses the Firebase Realtime Database below and keeps a copy on the device.
# "local" keeps scores on the device only.
VITE_LEADERBOARD=online

# Firebase web config. These values are public identifiers, not secrets: they are visible in
# every Firebase web app. Access is controlled by the Realtime Database security rules
# (see docs/LEADERBOARD.md). Override them in .env.local for a different project.
VITE_FIREBASE_API_KEY=AIzaSyDsrzprv7oBRa6Wf0EI3k4t4fI4Wwo3XEE
VITE_FIREBASE_AUTH_DOMAIN=scrabbleleaderboard-9b8d7.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://scrabbleleaderboard-9b8d7-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=scrabbleleaderboard-9b8d7
VITE_FIREBASE_APP_ID=1:33488919066:web:c518d8a5b36e47f453cfa3
