{
  "name": "word-nerd",
  "private": true,
  "version": "7.20.1",
  "type": "module",
  "scripts": {
    "words": "node scripts/build-wordlist.mjs",
    "check:bonuses": "vitest run data/__tests__/bonusData.test.ts",
    "predev": "npm run words",
    "dev": "vite",
    "prebuild": "npm run words && npm run check:bonuses",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run words",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/bungee": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.0.18",
    "word-list": "4.1.0",
    "wordlist-english": "1.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
